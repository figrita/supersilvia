---
source: tests/compile.rs
expression: wgsl
---

struct Uniforms {
    u_resolution: vec2f,
    u_time: f32,
    u_control_contrast1_brightness: f32,
    u_control_contrast1_contrast: f32,
}
@group(0) @binding(0) var<uniform> u: Uniforms;

fn contrast1_output(uv: vec2f) -> vec4f {
    let color = defaultUvMap(uv);
    let adjusted = (color.rgb - 0.5) * (u.u_control_contrast1_contrast) + 0.5 + (u.u_control_contrast1_brightness);
    return vec4f(clamp(adjusted, vec3f(0.0), vec3f(1.0)), color.a);
}

@fragment
fn fs_main(@builtin(position) frag_coord: vec4f) -> @location(0) vec4f {
    let screenUV = frag_coord.xy / u.u_resolution;
    let aspectRatio = u.u_resolution.x / u.u_resolution.y;
    let uv = vec2f((2.0 * screenUV.x - 1.0) * aspectRatio, 2.0 * screenUV.y - 1.0);
    return contrast1_output(uv);
}
