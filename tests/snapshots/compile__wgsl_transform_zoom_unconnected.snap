---
source: tests/compile.rs
expression: wgsl
---

struct Uniforms {
    u_resolution: vec2f,
    u_time: f32,
    u_control_zoom1_centerX: f32,
    u_control_zoom1_centerY: f32,
    u_control_zoom1_zoom: f32,
}
@group(0) @binding(0) var<uniform> u: Uniforms;

fn zoom1_output(uv: vec2f) -> vec4f {
    let center = vec2f(u.u_control_zoom1_centerX, u.u_control_zoom1_centerY);
    var zoomAmount = (u.u_control_zoom1_zoom);
    if (abs(zoomAmount) < 1e-6) { zoomAmount = select(1e-6, -1e-6, zoomAmount < 0.0); }
    let zoomedUV = (uv - center) / zoomAmount + center;
    return defaultUvMap(zoomedUV);
}

@fragment
fn fs_main(@builtin(position) frag_coord: vec4f) -> @location(0) vec4f {
    let screenUV = frag_coord.xy / u.u_resolution;
    let aspectRatio = u.u_resolution.x / u.u_resolution.y;
    let uv = vec2f((2.0 * screenUV.x - 1.0) * aspectRatio, 2.0 * screenUV.y - 1.0);
    return zoom1_output(uv);
}
