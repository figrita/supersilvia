---
source: tests/compile.rs
expression: wgsl
---

struct Uniforms {
    u_resolution: vec2f,
    u_time: f32,
    u_control_cosinegradient1_ampB: f32,
    u_control_cosinegradient1_ampG: f32,
    u_control_cosinegradient1_ampR: f32,
    u_control_cosinegradient1_biasB: f32,
    u_control_cosinegradient1_biasG: f32,
    u_control_cosinegradient1_biasR: f32,
    u_control_cosinegradient1_freqB: f32,
    u_control_cosinegradient1_freqG: f32,
    u_control_cosinegradient1_freqR: f32,
    u_control_cosinegradient1_phaseB: f32,
    u_control_cosinegradient1_phaseG: f32,
    u_control_cosinegradient1_phaseR: f32,
    u_control_vignette3_radius: f32,
    u_control_vignette3_softness: f32,
    u_control_vignette4_radius: f32,
    u_control_vignette4_softness: f32,
    u_count_cosinegradient1_clock: vec2f,
}
@group(0) @binding(0) var<uniform> u: Uniforms;

fn vignette3_mask(uv: vec2f) -> f32 {
    let radius = u.u_control_vignette3_radius;
    let softness = max(u.u_control_vignette3_softness, 1e-4);
    let mask = 1.0 - smoothstep(radius - softness, radius + softness, length(uv));
    return mask;
}

fn vignette4_mask(uv: vec2f) -> f32 {
    let radius = u.u_control_vignette4_radius;
    let softness = max(u.u_control_vignette4_softness, 1e-4);
    let mask = 1.0 - smoothstep(radius - softness, radius + softness, length(uv));
    return mask;
}

fn cosinegradient1_output(uv: vec2f) -> vec4f {
    let t = vignette3_mask(uv);
    let bias = vec3f(u.u_control_cosinegradient1_biasR, u.u_control_cosinegradient1_biasG, u.u_control_cosinegradient1_biasB);
    let amp = vec3f(u.u_control_cosinegradient1_ampR, u.u_control_cosinegradient1_ampG, u.u_control_cosinegradient1_ampB);
    let freq = clamp(floor(vec3f(u.u_control_cosinegradient1_freqR, u.u_control_cosinegradient1_freqG, u.u_control_cosinegradient1_freqB) + 0.5), vec3f(1.0), vec3f(4.0));
    let phase = vec3f(u.u_control_cosinegradient1_phaseR, u.u_control_cosinegradient1_phaseG, u.u_control_cosinegradient1_phaseB) + time_periodic(u.u_count_cosinegradient1_clock, vignette4_mask(uv));
    let rgb = bias + amp * cos(2.0 * PI * (freq * t + phase));
    return vec4f(clamp(rgb, vec3f(0.0), vec3f(1.0)), 1.0);
}

@fragment
fn fs_main(@builtin(position) frag_coord: vec4f) -> @location(0) vec4f {
    let screenUV = frag_coord.xy / u.u_resolution;
    let aspectRatio = u.u_resolution.x / u.u_resolution.y;
    let uv = vec2f((2.0 * screenUV.x - 1.0) * aspectRatio, 2.0 * screenUV.y - 1.0);
    return cosinegradient1_output(uv);
}
