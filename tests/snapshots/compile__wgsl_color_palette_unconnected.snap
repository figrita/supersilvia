    lab.x = clamp(lab.x + (-0.428571) * (u.u_control_palette1_lSpread) * 0.5, 0.0, 1.0);
    C = max(C + (-0.428571) * (u.u_control_palette1_cSpread) * 0.2, 0.0);
    lab = vec3f(lab.x, C * cos(H), C * sin(H));
    return vec4f(oklab2srgb(lab), src.a);
}

