    let src = checkerboard3_output(uv);
    var lab = srgb2oklab(src.rgb);
    var C = length(lab.yz);
    var H = atan2(lab.z, lab.y);
    let shaped = pow(0.285714, max(vignette6_mask(uv), 0.01));
    H += (vignette5_mask(uv)) * 6.28318530718 + (shaped - 0.5) * (vignette4_mask(uv)) * 6.28318530718;
    lab.x = clamp(lab.x + (-0.428571) * (vignette7_mask(uv)) * 0.5, 0.0, 1.0);
    C = max(C + (-0.428571) * (vignette8_mask(uv)) * 0.2, 0.0);
    lab = vec3f(lab.x, C * cos(H), C * sin(H));
    return vec4f(oklab2srgb(lab), src.a);
}

