---
source: tests/compile.rs
expression: wgsl
---

struct Uniforms {
    u_resolution: vec2f,
    u_time: f32,
    u_control_translate1_x: f32,
    u_control_translate1_y: f32,
}
@group(0) @binding(0) var<uniform> u: Uniforms;

fn translate1_output(uv: vec2f) -> vec4f {
    let translatedUV = uv - vec2f(u.u_control_translate1_x, u.u_control_translate1_y);
    return defaultUvMap(translatedUV);
}

@fragment
fn fs_main(@builtin(position) frag_coord: vec4f) -> @location(0) vec4f {
    let screenUV = frag_coord.xy / u.u_resolution;
    let aspectRatio = u.u_resolution.x / u.u_resolution.y;
    let uv = vec2f((2.0 * screenUV.x - 1.0) * aspectRatio, 2.0 * screenUV.y - 1.0);
    return translate1_output(uv);
}
