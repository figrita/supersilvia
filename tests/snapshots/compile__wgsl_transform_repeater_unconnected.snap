---
source: tests/compile.rs
expression: wgsl
---

struct Uniforms {
    u_resolution: vec2f,
    u_time: f32,
    u_control_mix4_amount: f32,
    u_control_repeater1_bgColor: vec4f,
    u_control_repeater1_columns: f32,
    u_control_repeater1_copyColor: vec4f,
    u_control_repeater1_copyScaleX: f32,
    u_control_repeater1_copyScaleY: f32,
    u_control_repeater1_copyTurn: f32,
    u_control_repeater1_copyX: f32,
    u_control_repeater1_copyY: f32,
    u_control_repeater1_rows: f32,
    u_control_repeater1_sourceHeight: f32,
    u_control_repeater1_sourceWidth: f32,
    u_control_repeater1_sourceX: f32,
    u_control_repeater1_sourceY: f32,
    u_control_repeater1_spacing: f32,
    u_control_rgba3_a: f32,
    u_control_rgba3_b: f32,
    u_control_rgba3_g: f32,
    u_opt_mix4_curve: i32,
    u_opt_mix4_method: i32,
}
@group(0) @binding(0) var<uniform> u: Uniforms;

fn percopy_place2(q: vec2f, offset: vec2f, turn: f32, scale: vec2f) -> vec2f {
    let a = -turn * 6.2831853;
    let c = cos(a);
    let s = sin(a);
    let t = q - offset;
    let held = select(vec2f(1.0e-4), vec2f(-1.0e-4), scale < vec2f(0.0));
    let sc = select(held, scale, abs(scale) > vec2f(1.0e-4));
    return vec2f(c * t.x - s * t.y, s * t.x + c * t.y) / sc;
}

fn repeater1_output(uv: vec2f) -> vec4f {
    let rows = max(floor(u.u_control_repeater1_rows), 1.0);
    let columns = max(floor(u.u_control_repeater1_columns), 1.0);
    let sourceWidth = max(u.u_control_repeater1_sourceWidth, 1e-3);
    let sourceHeight = max(u.u_control_repeater1_sourceHeight, 1e-3);
    let spacing = max(u.u_control_repeater1_spacing, 0.0);
    let cellWidth = sourceWidth + spacing;
    let cellHeight = sourceHeight + spacing;
    let totalWidth = columns * cellWidth - spacing;
    let totalHeight = rows * cellHeight - spacing;
    let gridOffset = vec2f(-totalWidth, -totalHeight) * 0.5;
    let gridUV = uv - gridOffset;
    let cellSize = vec2f(cellWidth, cellHeight);
    let cell = floor(gridUV / cellSize);
    let cellUV = clamp(floor_mod2(gridUV, cellSize), vec2f(0.0), cellSize);
    let copyOffset = vec2f(u.u_control_repeater1_copyX, u.u_control_repeater1_copyY);
    let copyTurn = u.u_control_repeater1_copyTurn;
    let copyScale = vec2f(u.u_control_repeater1_copyScaleX, u.u_control_repeater1_copyScaleY);
    let copyTint = u.u_control_repeater1_copyColor;
    let copyUV = percopy_place2(cellUV - vec2f(sourceWidth, sourceHeight) * 0.5,
        copyOffset, copyTurn, copyScale);
    let mask = step(0.0, cell.x) * step(cell.x, columns - 1.0)
        * step(0.0, cell.y) * step(cell.y, rows - 1.0)
        * step(abs(copyUV.x), sourceWidth * 0.5) * step(abs(copyUV.y), sourceHeight * 0.5);
    let sourceUV = vec2f(u.u_control_repeater1_sourceX, u.u_control_repeater1_sourceY) + copyUV;
    let copy = defaultUvMap(sourceUV) * copyTint;
    let bg = u.u_control_repeater1_bgColor;
    return mix(bg, copy + bg * (1.0 - copy.a), mask);
}

fn repeater1_mask(uv: vec2f) -> f32 {
    let rows = max(floor(u.u_control_repeater1_rows), 1.0);
    let columns = max(floor(u.u_control_repeater1_columns), 1.0);
    let sourceWidth = max(u.u_control_repeater1_sourceWidth, 1e-3);
    let sourceHeight = max(u.u_control_repeater1_sourceHeight, 1e-3);
    let spacing = max(u.u_control_repeater1_spacing, 0.0);
    let cellWidth = sourceWidth + spacing;
    let cellHeight = sourceHeight + spacing;
    let totalWidth = columns * cellWidth - spacing;
    let totalHeight = rows * cellHeight - spacing;
    let gridOffset = vec2f(-totalWidth, -totalHeight) * 0.5;
    let gridUV = uv - gridOffset;
    let cellSize = vec2f(cellWidth, cellHeight);
    let cell = floor(gridUV / cellSize);
    let cellUV = clamp(floor_mod2(gridUV, cellSize), vec2f(0.0), cellSize);
    let copyOffset = vec2f(u.u_control_repeater1_copyX, u.u_control_repeater1_copyY);
    let copyTurn = u.u_control_repeater1_copyTurn;
    let copyScale = vec2f(u.u_control_repeater1_copyScaleX, u.u_control_repeater1_copyScaleY);
    let copyTint = u.u_control_repeater1_copyColor;
    let copyUV = percopy_place2(cellUV - vec2f(sourceWidth, sourceHeight) * 0.5,
        copyOffset, copyTurn, copyScale);
    let mask = step(0.0, cell.x) * step(cell.x, columns - 1.0)
        * step(0.0, cell.y) * step(cell.y, rows - 1.0)
        * step(abs(copyUV.x), sourceWidth * 0.5) * step(abs(copyUV.y), sourceHeight * 0.5);
    return mask;
}

fn rgba3_output(uv: vec2f) -> vec4f {
    return premultiply(vec4f(repeater1_mask(uv), u.u_control_rgba3_g, u.u_control_rgba3_b, u.u_control_rgba3_a));
}

fn mix4_output(uv: vec2f) -> vec4f {
    let a = repeater1_output(uv);
    let b = rgba3_output(uv);
    let amt = clamp(u.u_control_mix4_amount, 0.0, 1.0);
    let f = select(
        amt,
        clamp(0.5 + 0.5 * tan(clamp(2.0 * amt - 1.0, -0.999, 0.999) * 1.5707963), 0.0, 1.0),
        u.u_opt_mix4_curve == 1);
    let lum = dot(a.rgb, vec3f(0.299, 0.587, 0.114));
    let m = u.u_opt_mix4_method;
    if (m == 1) {
        return select(a, b, lum < f);
    } else if (m == 2) {
        return select(a, b, lum > 1.0 - f);
    } else {
        return mix(a, b, f);
    }
}

@fragment
fn fs_main(@builtin(position) frag_coord: vec4f) -> @location(0) vec4f {
    let screenUV = frag_coord.xy / u.u_resolution;
    let aspectRatio = u.u_resolution.x / u.u_resolution.y;
    let uv = vec2f((2.0 * screenUV.x - 1.0) * aspectRatio, 2.0 * screenUV.y - 1.0);
    return mix4_output(uv);
}
