---
source: tests/compile.rs
expression: wgsl
---

struct Uniforms {
    u_resolution: vec2f,
    u_time: f32,
    u_control_radialblur1_amount: f32,
    u_control_radialblur1_centerX: f32,
    u_control_radialblur1_centerY: f32,
}
@group(0) @binding(0) var<uniform> u: Uniforms;

fn radialblur1_output(uv: vec2f) -> vec4f {
    let ray = (uv - vec2f(u.u_control_radialblur1_centerX, u.u_control_radialblur1_centerY)) * (u.u_control_radialblur1_amount);
    var sum = vec4f(0.0);
    var offset = vec2f(0.0);
    for (var i = 0; i < 16; i++) {
        offset = ray * (f32(i) / 15.0 - 0.5);
        sum += defaultUvMap(uv + offset);
    }
    return sum / 16.0;
}

@fragment
fn fs_main(@builtin(position) frag_coord: vec4f) -> @location(0) vec4f {
    let screenUV = frag_coord.xy / u.u_resolution;
    let aspectRatio = u.u_resolution.x / u.u_resolution.y;
    let uv = vec2f((2.0 * screenUV.x - 1.0) * aspectRatio, 2.0 * screenUV.y - 1.0);
    return radialblur1_output(uv);
}
