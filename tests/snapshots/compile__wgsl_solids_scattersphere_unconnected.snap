struct Uniforms {
    u_resolution: vec2f,
    u_time: f32,
    u_control_scattersphere1_copies: f32,
    u_control_scattersphere1_copyColor: vec4f,
    u_control_scattersphere1_copyScaleX: f32,
    u_control_scattersphere1_copyScaleY: f32,
    u_control_scattersphere1_copyScaleZ: f32,
    u_control_scattersphere1_copyTurn: f32,
    u_control_scattersphere1_copyX: f32,
    u_control_scattersphere1_copyY: f32,
    u_control_scattersphere1_copyZ: f32,
    u_control_scattersphere1_radius: f32,
    u_control_solidrender3_background: vec4f,
    u_control_solidrender3_distance: f32,
    u_control_solidrender3_floorHeight: f32,
    u_control_solidrender3_fog: f32,
    u_control_solidrender3_glowAmount: f32,
    u_control_solidrender3_glowColor: vec4f,
    u_control_solidrender3_glowReach: f32,
    u_control_solidrender3_lens: f32,
    u_control_solidrender3_light: f32,
    u_control_solidrender3_lightHeight: f32,
    u_control_solidrender3_orbit: f32,
    u_control_solidrender3_step: f32,
    u_control_solidrender3_targetX: f32,
    u_control_solidrender3_targetY: f32,
    u_control_solidrender3_targetZ: f32,
    u_control_solidrender3_tilt: f32,
}
@group(0) @binding(0) var<uniform> u: Uniforms;

// Solids.
fn sd_rot2(v: vec2f, a: f32) -> vec2f {
    let c = cos(a);
    let s = sin(a);
    return vec2f(c * v.x - s * v.y, s * v.x + c * v.y);
}
// Turn a point by yaw (around y), pitch (around x) and roll (around z), in radians.
fn sd_turn(p: vec3f, a: vec3f) -> vec3f {
    let xz = sd_rot2(p.xz, a.x);
    var q = vec3f(xz.x, p.y, xz.y);
    let yz = sd_rot2(q.yz, a.y);
    q = vec3f(q.x, yz.x, yz.y);
    let xy = sd_rot2(q.xy, a.z);
    return vec3f(xy.x, xy.y, q.z);
}
// Smooth minimum with its blend carried into the color, so a seam between two colors is as
// soft as the seam between the two shapes. A radius of zero is the hard union.
fn sd_union(a: vec4f, b: vec4f, k: f32) -> vec4f {
    if (k <= 0.0) { return select(b, a, a.x < b.x); }
    let h = clamp(0.5 + 0.5 * (b.x - a.x) / k, 0.0, 1.0);
    return vec4f(mix(b.x, a.x, h) - k * h * (1.0 - h), mix(b.yzw, a.yzw, h));
}
// `a` with `b` carved out of it. The cut face takes `b`'s color.
fn sd_subtract(a: vec4f, b: vec4f, k: f32) -> vec4f {
    if (k <= 0.0) { return select(a, vec4f(-b.x, b.yzw), -b.x > a.x); }
    let h = clamp(0.5 - 0.5 * (a.x + b.x) / k, 0.0, 1.0);
    return vec4f(mix(a.x, -b.x, h) + k * h * (1.0 - h), mix(a.yzw, b.yzw, h));
}
fn sd_intersect(a: vec4f, b: vec4f, k: f32) -> vec4f {
    if (k <= 0.0) { return select(b, a, a.x > b.x); }
    let h = clamp(0.5 - 0.5 * (b.x - a.x) / k, 0.0, 1.0);
    return vec4f(mix(b.x, a.x, h) + k * h * (1.0 - h), mix(b.yzw, a.yzw, h));
}
// Three numbers, 0 to 1, from a whole-numbered cell and a seed: integer arithmetic only, so a
// cell scatters the same way on every GPU and in every session.
fn sd_hash3(cell: vec3f, seed: f32) -> vec3f {
    var v = bitcast<vec3u>(vec3i(cell) + vec3i(i32(seed) * 1597, i32(seed) * 3571, i32(seed) * 7919));
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v = v ^ (v >> vec3u(16u));
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return vec3f(v) * (1.0 / 4294967295.0);
}
// A box holding a solid. An empty one has lo above hi.
struct SdBounds {
    lo: vec3f,
    hi: vec3f,
}
fn sd_bounds_empty(b: SdBounds) -> bool {
    return any(b.lo > b.hi);
}
fn sd_bounds_union(a: SdBounds, b: SdBounds) -> SdBounds {
    return SdBounds(min(a.lo, b.lo), max(a.hi, b.hi));
}
fn sd_bounds_meet(a: SdBounds, b: SdBounds) -> SdBounds {
    return SdBounds(max(a.lo, b.lo), min(a.hi, b.hi));
}
fn sd_bounds_grow(b: SdBounds, k: f32) -> SdBounds {
    if (sd_bounds_empty(b)) { return b; }
    return SdBounds(b.lo - vec3f(max(k, 0.0)), b.hi + vec3f(max(k, 0.0)));
}
fn sd_bounds_move(b: SdBounds, t: vec3f) -> SdBounds {
    return SdBounds(b.lo + t, b.hi + t);
}
// `b` scaled by `s` about `pivot`, and turned about it where `turned`: a turned box is held by
// the ball round its corners.
fn sd_bounds_about(b: SdBounds, pivot: vec3f, turned: bool, s: f32) -> SdBounds {
    if (sd_bounds_empty(b)) { return b; }
    if (!turned) { return SdBounds(pivot + (b.lo - pivot) * s, pivot + (b.hi - pivot) * s); }
    let r = length(max(abs(b.lo - pivot), abs(b.hi - pivot))) * s;
    return SdBounds(pivot - vec3f(r), pivot + vec3f(r));
}
// How far a solid reaches from its own origin along each axis.
fn sd_bounds_reach(b: SdBounds) -> vec3f {
    if (sd_bounds_empty(b)) { return vec3f(0.0); }
    return max(abs(b.lo), abs(b.hi));
}
// How far a repeat's copy reaches from its cell's center: its input's reach scaled by the most
// any copy is scaled, swung round y where any copy turns, and moved by the most any is moved.
fn sd_copy_reach(b: SdBounds, offset: vec3f, scale: vec3f, turned: bool) -> vec3f {
    var r = sd_bounds_reach(b) * scale;
    if (turned) {
        let xz = length(r.xz);
        r = vec3f(xz, r.y, xz);
    }
    return r + offset;
}
// The distance from `p` to the box `c` ± `h`, zero inside it.
fn sd_box_gap(p: vec3f, c: vec3f, h: vec3f) -> f32 {
    return length(max(abs(p - c) - h, vec3f(0.0)));
}
// A fully saturated hue, 0 to 1 round the wheel.
fn sd_hue(h: f32) -> vec3f {
    return clamp(abs(fract(h + vec3f(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, vec3f(0.0), vec3f(1.0));
}

// Point `i` of `n` on the unit sphere's Fibonacci lattice, the first nearest +y.
fn sd_fibonacci_point(i: f32, n: f32) -> vec3f {
    let phi = 6.2831853 * fract(i * 0.61803399);
    let y = 1.0 - (2.0 * i + 1.0) / n;
    let r = sqrt(max(1.0 - y * y, 0.0));
    return vec3f(cos(phi) * r, y, sin(phi) * r);
}
// The index of the lattice point nearest the unit direction `v`: the four lattice points round
// it, from Keinert et al.'s inverse mapping, and the nearest of those.
fn sd_fibonacci_nearest(v: vec3f, n: f32) -> f32 {
    let golden = 1.61803399;
    let m = 1.0 - 1.0 / n;
    let phi = atan2(v.z, v.x);
    let y = clamp(v.y, -1.0, 1.0);
    let k = max(2.0, floor(log(n * 7.0248147 * max(1.0 - y * y, 1.0e-6)) / 0.96242365));
    let fk = pow(golden, k) / 2.2360680;
    let f = vec2f(round(fk), round(fk * golden));
    let ka = 2.0 * f / n;
    let kb = 6.2831853 * (fract((f + 1.0) * golden) - 0.61803399);
    let det = ka.y * kb.x - ka.x * kb.y;
    let c = floor(vec2f(ka.y * phi + kb.y * (y - m), -ka.x * phi - kb.x * (y - m)) / det);
    var best = 8.0;
    var j = 0.0;
    for (var s = 0; s < 4; s++) {
        let corner = vec2f(f32(s % 2), f32(s / 2));
        let i = clamp(dot(f, corner + c), 0.0, n - 1.0);
        let e = sd_fibonacci_point(i, n) - v;
        let dd = dot(e, e);
        if (dd < best) {
            best = dd;
            j = i;
        }
    }
    return j;
}

// Copies listed, not folded: see compile/instances.rs.
// A copy: the rigid map into its frame as three rows, w = (dot(r0.xyz, p) + r0.w, ...), its
// scale on the input's axes, its color, and its box in the repeat's space.
struct SdInstance {
    r0: vec4f,
    r1: vec4f,
    r2: vec4f,
    scale: vec4f,
    color: vec4f,
    lo: vec4f,
    hi: vec4f,
}
// A repeat's grid: its corner (w the margin), the far corner of its cells (w the copies), a
// cell's size (w 1 where this draw's lists hold every copy), and the cells along each axis (w
// all of them).
struct SdGrid {
    lo: vec4f,
    hi: vec4f,
    cs: vec4f,
    res: vec4u,
}
@group(0) @binding(100) var<storage, read_write> sd_inst: array<SdInstance>;
@group(0) @binding(101) var<storage, read_write> sd_grid: array<SdGrid>;
@group(0) @binding(102) var<storage, read_write> sd_count: array<atomic<u32>>;
@group(0) @binding(103) var<storage, read_write> sd_list: array<u32>;
var<workgroup> sd_scan_part: array<u32, 256>;

// The copy whose frame map takes the origin to `o` and the three axes to `ex`, `ey` and `ez`,
// scaled by `scale` and colored `color`, over an input held by `b`.
fn sd_instance(o: vec3f, ex: vec3f, ey: vec3f, ez: vec3f, scale: vec3f, color: vec3f, b: SdBounds) -> SdInstance {
    let cx = ex - o;
    let cy = ey - o;
    let cz = ez - o;
    var lo = vec3f(1.0e9);
    var hi = vec3f(-1.0e9);
    if (!sd_bounds_empty(b)) {
        for (var k = 0u; k < 8u; k++) {
            let corner = select(b.lo, b.hi, vec3<bool>((k & 1u) != 0u, (k & 2u) != 0u, (k & 4u) != 0u));
            let v = corner * scale - o;
            let q = vec3f(dot(cx, v), dot(cy, v), dot(cz, v));
            lo = min(lo, q);
            hi = max(hi, q);
        }
    }
    return SdInstance(
        vec4f(cx.x, cy.x, cz.x, o.x),
        vec4f(cx.y, cy.y, cz.y, o.y),
        vec4f(cx.z, cy.z, cz.z, o.z),
        vec4f(scale, 0.0),
        vec4f(color, 0.0),
        vec4f(lo, 0.0),
        vec4f(hi, 0.0),
    );
}

// A copy's own frame inside its place: the point moved to the copy's origin `at` and turned
// by `turn`, in radians, about y.
fn sd_copy_frame(x: vec3f, at: vec3f, turn: f32) -> vec3f {
    let m = x - at;
    let mt = sd_rot2(m.xz, turn);
    return vec3f(mt.x, m.y, mt.y);
}

// Copy `c` written at `at`, its box's size kept where it is the biggest yet: in the three words
// from `ext`, as the bits of a positive float, which order as the floats do.
fn sd_place(at: u32, ext: u32, c: SdInstance) {
    sd_inst[at] = c;
    if (all(c.lo.xyz <= c.hi.xyz)) {
        let e = c.hi.xyz - c.lo.xyz;
        atomicMax(&sd_count[ext], bitcast<u32>(e.x));
        atomicMax(&sd_count[ext + 1u], bitcast<u32>(e.y));
        atomicMax(&sd_count[ext + 2u], bitcast<u32>(e.z));
    }
}

// A repeat's grid cut from the box and count the place pass wrote, by the biggest copy it
// found, and that copy's size forgotten for the next draw.
fn sd_grid_finish(gi: u32, ext: u32, cap: f32) {
    let h = sd_grid[gi];
    let size = vec3f(
        bitcast<f32>(atomicLoad(&sd_count[ext])),
        bitcast<f32>(atomicLoad(&sd_count[ext + 1u])),
        bitcast<f32>(atomicLoad(&sd_count[ext + 2u])),
    );
    var g = sd_grid_make(SdBounds(h.lo.xyz, h.hi.xyz), h.hi.w, size, cap);
    g.cs.w = min(g.cs.w, h.cs.w);
    sd_grid[gi] = g;
    atomicStore(&sd_count[ext], 0u);
    atomicStore(&sd_count[ext + 1u], 0u);
    atomicStore(&sd_count[ext + 2u], 0u);
}

// The point `p` of the repeat's space in a copy's frame, before its scale.
fn sd_instance_point(c: SdInstance, p: vec3f) -> vec3f {
    return vec3f(dot(c.r0.xyz, p) + c.r0.w, dot(c.r1.xyz, p) + c.r1.w, dot(c.r2.xyz, p) + c.r2.w);
}

// The grid for `n` copies inside `b`, each at most `size` across on each axis: about two cells a
// copy, none narrower than a copy along any axis, at most `cap` in all. The margin is half the
// narrowest cell, so a copy grown by it touches at most three cells along each axis.
fn sd_grid_make(b: SdBounds, n: f32, size: vec3f, cap: f32) -> SdGrid {
    var lo = b.lo;
    var e = b.hi - b.lo;
    if (sd_bounds_empty(b)) {
        lo = vec3f(0.0);
        e = vec3f(0.0);
    }
    e = max(e, vec3f(1.0e-4));
    let want = clamp(2.0 * n, 1.0, cap);
    var c = max(e.x, max(e.y, e.z));
    for (var k = 0; k < 64; k++) {
        let r = max(ceil(e / c), vec3f(1.0));
        if (r.x * r.y * r.z >= want) { break; }
        c *= 0.85;
    }
    var cs = max(vec3f(c), size);
    for (var k = 0; k < 64; k++) {
        let r = max(ceil(e / cs), vec3f(1.0));
        if (r.x * r.y * r.z <= cap) { break; }
        cs *= 1.2;
    }
    let res = vec3u(max(ceil(e / cs), vec3f(1.0)));
    return SdGrid(
        vec4f(lo, 0.5 * min(cs.x, min(cs.y, cs.z))),
        vec4f(lo + vec3f(res) * cs, n),
        vec4f(cs, 1.0),
        vec4u(res, res.x * res.y * res.z),
    );
}

// The cells, first and last along each axis, that a box grown by the margin touches.
fn sd_grid_span(g: SdGrid, lo: vec3f, hi: vec3f) -> array<vec3u, 2> {
    let top = vec3f(g.res.xyz) - 1.0;
    let a = clamp(floor((lo - g.lo.w - g.lo.xyz) / g.cs.xyz), vec3f(0.0), top);
    let z = clamp(floor((hi + g.lo.w - g.lo.xyz) / g.cs.xyz), vec3f(0.0), top);
    return array<vec3u, 2>(vec3u(a), vec3u(z));
}

// The cell holding `p`, or the nearest to it.
fn sd_grid_cell(g: SdGrid, p: vec3f) -> u32 {
    let c = vec3u(clamp(floor((p - g.lo.xyz) / g.cs.xyz), vec3f(0.0), vec3f(g.res.xyz) - 1.0));
    return c.x + g.res.x * (c.y + g.res.y * c.z);
}

// Copy `i`'s count added to every cell it touches.
fn sd_grid_count(gi: u32, count_base: u32, item_base: u32, i: u32) {
    let g = sd_grid[gi];
    let c = sd_inst[item_base + i];
    if (any(c.lo.xyz > c.hi.xyz)) { return; }
    let s = sd_grid_span(g, c.lo.xyz, c.hi.xyz);
    for (var z = s[0].z; z <= s[1].z; z++) {
        for (var y = s[0].y; y <= s[1].y; y++) {
            for (var x = s[0].x; x <= s[1].x; x++) {
                atomicAdd(&sd_count[count_base + x + g.res.x * (y + g.res.y * z)], 1u);
            }
        }
    }
}

// Copy `i` written into every cell it touches.
fn sd_grid_fill(gi: u32, count_base: u32, list_base: u32, cells: u32, entries: u32, item_base: u32, i: u32) {
    let g = sd_grid[gi];
    let c = sd_inst[item_base + i];
    if (any(c.lo.xyz > c.hi.xyz)) { return; }
    let s = sd_grid_span(g, c.lo.xyz, c.hi.xyz);
    for (var z = s[0].z; z <= s[1].z; z++) {
        for (var y = s[0].y; y <= s[1].y; y++) {
            for (var x = s[0].x; x <= s[1].x; x++) {
                let cell = x + g.res.x * (y + g.res.y * z);
                let at = sd_list[list_base + cell] + atomicAdd(&sd_count[count_base + cell], 1u);
                if (at < entries) { sd_list[list_base + cells + at] = i; }
            }
        }
    }
}

// One workgroup of 256: every cell's count turned into the start of its list, the counts
// zeroed for the fill to count again, and the grid marked unusable where the lists overflow.
fn sd_grid_scan(gi: u32, count_base: u32, list_base: u32, entries: u32, lid: u32) {
    let cells = sd_grid[gi].res.w;
    let per = (cells + 255u) / 256u;
    let first = min(lid * per, cells);
    let last = min(first + per, cells);
    var sum = 0u;
    for (var k = first; k < last; k++) {
        sum += atomicLoad(&sd_count[count_base + k]);
    }
    sd_scan_part[lid] = sum;
    workgroupBarrier();
    for (var off = 1u; off < 256u; off *= 2u) {
        var v = 0u;
        if (lid >= off) { v = sd_scan_part[lid - off]; }
        workgroupBarrier();
        sd_scan_part[lid] += v;
        workgroupBarrier();
    }
    var start = sd_scan_part[lid] - sum;
    for (var k = first; k < last; k++) {
        let n = atomicLoad(&sd_count[count_base + k]);
        sd_list[list_base + k] = start;
        start += n;
        atomicStore(&sd_count[count_base + k], 0u);
    }
    if (lid == 255u && sd_scan_part[255] > entries) {
        sd_grid[gi].cs.w = 0.0;
    }
}


fn scattersphere1_place(t: u32) {
    let n = clamp(round(u.u_control_scattersphere1_copies), 1.0, 500.0);
    let bx = SdBounds(vec3f(1.0e9), vec3f(-1.0e9));
    let total = max(n, 0.0);
    if (t == 0u) {
        var b = SdBounds(-(vec3f(u.u_control_scattersphere1_radius + length(sd_copy_reach(SdBounds(vec3f(1.0e9), vec3f(-1.0e9)), vec3f(abs(u.u_control_scattersphere1_copyX), abs(u.u_control_scattersphere1_copyY), abs(u.u_control_scattersphere1_copyZ)), vec3f(abs(u.u_control_scattersphere1_copyScaleX), abs(u.u_control_scattersphere1_copyScaleY), abs(u.u_control_scattersphere1_copyScaleZ)), abs(u.u_control_scattersphere1_copyTurn) > 0.0)))), vec3f(u.u_control_scattersphere1_radius + length(sd_copy_reach(SdBounds(vec3f(1.0e9), vec3f(-1.0e9)), vec3f(abs(u.u_control_scattersphere1_copyX), abs(u.u_control_scattersphere1_copyY), abs(u.u_control_scattersphere1_copyZ)), vec3f(abs(u.u_control_scattersphere1_copyScaleX), abs(u.u_control_scattersphere1_copyScaleY), abs(u.u_control_scattersphere1_copyScaleZ)), abs(u.u_control_scattersphere1_copyTurn) > 0.0))));
        if (sd_bounds_empty(b)) { b = SdBounds(vec3f(0.0), vec3f(0.0)); }
        sd_grid[0u] = SdGrid(
            vec4f(b.lo, 0.0),
            vec4f(b.hi, total),
            vec4f(0.0, 0.0, 0.0, select(1.0, 0.0, total > 500.0)),
            vec4u(0u),
        );
    }
    if (t < 4096u) { atomicStore(&sd_count[0u + t], 0u); }
    if (f32(t) >= min(total, 500.0)) { return; }
    let i = f32(t);
    let up = sd_fibonacci_point(i, n);
    let sg = select(-1.0, 1.0, up.z >= 0.0);
    let a = -1.0 / (sg + up.z);
    let b = up.x * up.y * a;
    let side = vec3f(1.0 + sg * up.x * up.x * a, sg * b, -sg * up.x);
    let back = vec3f(b, sg + up.y * up.y * a, -up.y);
    let at = vec3f(u.u_control_scattersphere1_copyX, u.u_control_scattersphere1_copyY, u.u_control_scattersphere1_copyZ);
    let turn = -(u.u_control_scattersphere1_copyTurn) * 6.2831853;
    var f: array<vec3f, 4>;
    for (var e = 0; e < 4; e++) {
        let p = vec3f(f32(e == 1), f32(e == 2), f32(e == 3));
        let dp = p - up * u.u_control_scattersphere1_radius;
        f[e] = sd_copy_frame(vec3f(dot(dp, side), dot(dp, up), -dot(dp, back)), at, turn);
    }
    sd_place(0u + t, 4096u, sd_instance(f[0], f[1], f[2], f[3], max(vec3f(u.u_control_scattersphere1_copyScaleX, u.u_control_scattersphere1_copyScaleY, u.u_control_scattersphere1_copyScaleZ), vec3f(1.0e-4)), u.u_control_scattersphere1_copyColor.rgb, bx));
}

fn scattersphere1_solid_d(p: vec3f) -> vec4f {
    if (sd_grid[0u].cs.w > 0.5) {
        let g = sd_grid[0u];
        let gap = sd_box_gap(p, (g.lo.xyz + g.hi.xyz) * 0.5, (g.hi.xyz - g.lo.xyz) * 0.5);
        var best = vec4f(1.0e9, 0.0, 0.0, 0.0);
        var bi = 0xffffffffu;
        if (sd_march) { best.x = max(gap, g.lo.w - gap); }
        let cell = sd_grid_cell(g, p);
        let count = min(atomicLoad(&sd_count[0u + cell]), 13500u);
        let start = sd_list[0u + cell];
        for (var j = 0u; j < count; j++) {
            if (start + j >= 13500u) { break; }
            let i = sd_list[0u + 4096u + start + j];
            let c = sd_inst[0u + i];
            let cgap = sd_box_gap(p, (c.lo.xyz + c.hi.xyz) * 0.5, (c.hi.xyz - c.lo.xyz) * 0.5);
            if (cgap > best.x || (cgap == best.x && i > bi)) { continue; }
            let w = sd_instance_point(c, p);
            let sc = c.scale.xyz;
            let r = vec4f(1.0e4, 0.5, 0.5, 0.5);
            let k = min(sc.x, min(sc.y, sc.z));
            let d = select(r.x * k, max(r.x * k, cgap), cgap > 0.0);
            if (d < best.x || (d == best.x && i < bi)) {
                best = vec4f(d, r.yzw);
                bi = i;
            }
        }
        return best;
    }
    let n = clamp(round(u.u_control_scattersphere1_copies), 1.0, 500.0);
    let lp = length(p);
    let v = p / max(lp, 1.0e-6);
    let bx = SdBounds(vec3f(1.0e9), vec3f(-1.0e9));
    let inreach = sd_bounds_reach(bx);
    let reach = sd_copy_reach(bx, vec3f(abs(u.u_control_scattersphere1_copyX), abs(u.u_control_scattersphere1_copyY), abs(u.u_control_scattersphere1_copyZ)), vec3f(abs(u.u_control_scattersphere1_copyScaleX), abs(u.u_control_scattersphere1_copyScaleY), abs(u.u_control_scattersphere1_copyScaleZ)), abs(u.u_control_scattersphere1_copyTurn) > 0.0);
    let low = u.u_control_scattersphere1_radius + min(bx.lo.y * (vec3f(abs(u.u_control_scattersphere1_copyScaleX), abs(u.u_control_scattersphere1_copyScaleY), abs(u.u_control_scattersphere1_copyScaleZ))).y, 0.0) - (vec3f(abs(u.u_control_scattersphere1_copyX), abs(u.u_control_scattersphere1_copyY), abs(u.u_control_scattersphere1_copyZ))).y;
    let margin = min(sqrt(12.566371 / n), 1.5707963);
    var within = 3.1415927;
    if (low > 0.0) { within = min(atan2(length(reach.xz), low) + margin, 3.1415927); }
    let cmin = cos(within);
    let pv = acos(clamp(v.y, -1.0, 1.0));
    let i0 = max(floor((1.0 - cos(max(pv - within, 0.0))) * n * 0.5 - 0.5), 0.0);
    let i1 = min(ceil((1.0 - cos(min(pv + within, 3.1415927))) * n * 0.5 - 0.5), n - 1.0);
    let sv = sqrt(max(1.0 - v.y * v.y, 0.0));
    let av = atan2(v.z, v.x);
    var best = vec4f(1.0e9, 0.0, 0.0, 0.0);
    for (var i = i0; i <= i1; i += 1.0) {
        let yi = 1.0 - (2.0 * i + 1.0) / n;
        let ai = 6.2831853 * fract(i * 0.61803399);
        if (yi * v.y + sqrt(max(1.0 - yi * yi, 0.0)) * sv * cos(ai - av) < cmin) { continue; }
        let up = sd_fibonacci_point(i, n);
        let sg = select(-1.0, 1.0, up.z >= 0.0);
        let a = -1.0 / (sg + up.z);
        let b = up.x * up.y * a;
        let side = vec3f(1.0 + sg * up.x * up.x * a, sg * b, -sg * up.x);
        let back = vec3f(b, sg + up.y * up.y * a, -up.y);
        let dp = p - up * u.u_control_scattersphere1_radius;
        let q = vec3f(dot(dp, side), dot(dp, up), -dot(dp, back));
        var ch = inreach * abs(max(vec3f(u.u_control_scattersphere1_copyScaleX, u.u_control_scattersphere1_copyScaleY, u.u_control_scattersphere1_copyScaleZ), vec3f(1.0e-4)));
        if ((u.u_control_scattersphere1_copyTurn) != 0.0) { ch = vec3f(length(ch.xz), ch.y, length(ch.xz)); }
        let gap = sd_box_gap(q, vec3f(u.u_control_scattersphere1_copyX, u.u_control_scattersphere1_copyY, u.u_control_scattersphere1_copyZ), ch);
        if (gap >= best.x) { continue; }
        let sc = max(vec3f(u.u_control_scattersphere1_copyScaleX, u.u_control_scattersphere1_copyScaleY, u.u_control_scattersphere1_copyScaleZ), vec3f(1.0e-4));
        var m = q - vec3f(u.u_control_scattersphere1_copyX, u.u_control_scattersphere1_copyY, u.u_control_scattersphere1_copyZ);
        let mt = sd_rot2(m.xz, -(u.u_control_scattersphere1_copyTurn) * 6.2831853);
        m = vec3f(mt.x, m.y, mt.y) / sc;
        let k = min(sc.x, min(sc.y, sc.z));
        let r = vec4f(1.0e4, 0.5, 0.5, 0.5);
        let d = select(r.x * k, max(r.x * k, gap), gap > 0.0);
        if (d < best.x) { best = vec4f(d, r.yzw); }
    }
    if (sd_march && within < 3.1415927) { best.x = min(best.x, lp * sin(margin)); }
    return best;
}

fn scattersphere1_solid(p: vec3f) -> vec4f {
    if (sd_grid[0u].cs.w > 0.5) {
        let g = sd_grid[0u];
        let gap = sd_box_gap(p, (g.lo.xyz + g.hi.xyz) * 0.5, (g.hi.xyz - g.lo.xyz) * 0.5);
        var best = vec4f(1.0e9, 0.0, 0.0, 0.0);
        var bi = 0xffffffffu;
        if (sd_march) { best.x = max(gap, g.lo.w - gap); }
        let cell = sd_grid_cell(g, p);
        let count = min(atomicLoad(&sd_count[0u + cell]), 13500u);
        let start = sd_list[0u + cell];
        for (var j = 0u; j < count; j++) {
            if (start + j >= 13500u) { break; }
            let i = sd_list[0u + 4096u + start + j];
            let c = sd_inst[0u + i];
            let cgap = sd_box_gap(p, (c.lo.xyz + c.hi.xyz) * 0.5, (c.hi.xyz - c.lo.xyz) * 0.5);
            if (cgap > best.x || (cgap == best.x && i > bi)) { continue; }
            let w = sd_instance_point(c, p);
            let sc = c.scale.xyz;
            let r = vec4f(1.0e4, 0.5, 0.5, 0.5);
            let k = min(sc.x, min(sc.y, sc.z));
            let d = select(r.x * k, max(r.x * k, cgap), cgap > 0.0);
            if (d < best.x || (d == best.x && i < bi)) {
                best = vec4f(d, r.yzw * c.color.xyz);
                bi = i;
            }
        }
        return best;
    }
    let n = clamp(round(u.u_control_scattersphere1_copies), 1.0, 500.0);
    let lp = length(p);
    let v = p / max(lp, 1.0e-6);
    let bx = SdBounds(vec3f(1.0e9), vec3f(-1.0e9));
    let inreach = sd_bounds_reach(bx);
    let reach = sd_copy_reach(bx, vec3f(abs(u.u_control_scattersphere1_copyX), abs(u.u_control_scattersphere1_copyY), abs(u.u_control_scattersphere1_copyZ)), vec3f(abs(u.u_control_scattersphere1_copyScaleX), abs(u.u_control_scattersphere1_copyScaleY), abs(u.u_control_scattersphere1_copyScaleZ)), abs(u.u_control_scattersphere1_copyTurn) > 0.0);
    let low = u.u_control_scattersphere1_radius + min(bx.lo.y * (vec3f(abs(u.u_control_scattersphere1_copyScaleX), abs(u.u_control_scattersphere1_copyScaleY), abs(u.u_control_scattersphere1_copyScaleZ))).y, 0.0) - (vec3f(abs(u.u_control_scattersphere1_copyX), abs(u.u_control_scattersphere1_copyY), abs(u.u_control_scattersphere1_copyZ))).y;
    let margin = min(sqrt(12.566371 / n), 1.5707963);
    var within = 3.1415927;
    if (low > 0.0) { within = min(atan2(length(reach.xz), low) + margin, 3.1415927); }
    let cmin = cos(within);
    let pv = acos(clamp(v.y, -1.0, 1.0));
    let i0 = max(floor((1.0 - cos(max(pv - within, 0.0))) * n * 0.5 - 0.5), 0.0);
    let i1 = min(ceil((1.0 - cos(min(pv + within, 3.1415927))) * n * 0.5 - 0.5), n - 1.0);
    let sv = sqrt(max(1.0 - v.y * v.y, 0.0));
    let av = atan2(v.z, v.x);
    var best = vec4f(1.0e9, 0.0, 0.0, 0.0);
    for (var i = i0; i <= i1; i += 1.0) {
        let yi = 1.0 - (2.0 * i + 1.0) / n;
        let ai = 6.2831853 * fract(i * 0.61803399);
        if (yi * v.y + sqrt(max(1.0 - yi * yi, 0.0)) * sv * cos(ai - av) < cmin) { continue; }
        let up = sd_fibonacci_point(i, n);
        let sg = select(-1.0, 1.0, up.z >= 0.0);
        let a = -1.0 / (sg + up.z);
        let b = up.x * up.y * a;
        let side = vec3f(1.0 + sg * up.x * up.x * a, sg * b, -sg * up.x);
        let back = vec3f(b, sg + up.y * up.y * a, -up.y);
        let dp = p - up * u.u_control_scattersphere1_radius;
        let q = vec3f(dot(dp, side), dot(dp, up), -dot(dp, back));
        var ch = inreach * abs(max(vec3f(u.u_control_scattersphere1_copyScaleX, u.u_control_scattersphere1_copyScaleY, u.u_control_scattersphere1_copyScaleZ), vec3f(1.0e-4)));
        if ((u.u_control_scattersphere1_copyTurn) != 0.0) { ch = vec3f(length(ch.xz), ch.y, length(ch.xz)); }
        let gap = sd_box_gap(q, vec3f(u.u_control_scattersphere1_copyX, u.u_control_scattersphere1_copyY, u.u_control_scattersphere1_copyZ), ch);
        if (gap >= best.x) { continue; }
        let sc = max(vec3f(u.u_control_scattersphere1_copyScaleX, u.u_control_scattersphere1_copyScaleY, u.u_control_scattersphere1_copyScaleZ), vec3f(1.0e-4));
        var m = q - vec3f(u.u_control_scattersphere1_copyX, u.u_control_scattersphere1_copyY, u.u_control_scattersphere1_copyZ);
        let mt = sd_rot2(m.xz, -(u.u_control_scattersphere1_copyTurn) * 6.2831853);
        m = vec3f(mt.x, m.y, mt.y) / sc;
        let k = min(sc.x, min(sc.y, sc.z));
        let r = vec4f(1.0e4, 0.5, 0.5, 0.5);
        let d = select(r.x * k, max(r.x * k, gap), gap > 0.0);
        if (d < best.x) { best = vec4f(d, r.yzw * u.u_control_scattersphere1_copyColor.rgb); }
    }
    if (sd_march && within < 3.1415927) { best.x = min(best.x, lp * sin(margin)); }
    return best;
}

fn solidrender3_output(uv: vec2f) -> vec4f {
    let tau = 6.2831853;
    let orbit = u.u_control_solidrender3_orbit * tau;
    let tilt = u.u_control_solidrender3_tilt * tau;
    let aim = vec3f(u.u_control_solidrender3_targetX, u.u_control_solidrender3_targetY, u.u_control_solidrender3_targetZ);
    let ro = aim + u.u_control_solidrender3_distance * vec3f(cos(tilt) * sin(orbit), sin(tilt), cos(tilt) * cos(orbit));
    let fwd = normalize(aim - ro);
    let right = normalize(cross(fwd, vec3f(0.0, 1.0, 0.0)));
    let up = cross(right, fwd);
    let rd = normalize(fwd * u.u_control_solidrender3_lens + right * uv.x + up * uv.y);
    let fh = u.u_control_solidrender3_floorHeight;
    let bg = u.u_control_solidrender3_background;
    let relax = u.u_control_solidrender3_step;
    var pp = vec3f(0.0);
    var t = 0.0;
    var hit = false;
    var count = 0.0;
    let glowing = u.u_control_solidrender3_glowAmount > 0.0;
    let reach = max(u.u_control_solidrender3_glowReach, 0.001);
    var acc = 0.0;
    sd_march = true;
    for (var i = 0; i < 128; i++) {
        pp = ro + rd * t;
        let hs = scattersphere1_solid_d(pp).x;
        let h = min((pp.y - fh), hs);
        if (h < 0.0004 * t + 0.0001) { hit = true; break; }
        if (glowing) { acc += exp(-hs / reach) * h * relax; }
        t += h * relax;
        count += 1.0;
        if (t > 80.0) { break; }
    }
    sd_march = false;
    if (!hit && t <= 80.0) {
        pp = ro + rd * t;
        if (min((pp.y - fh), scattersphere1_solid_d(pp).x) < 0.003 * (max(t, 0.001) / max(u.u_control_solidrender3_lens, 0.001))) {
            hit = true;
        } else if (rd.y < 0.0) {
            let tf = (ro.y - fh - 0.0001) / (0.0004 - rd.y);
            if (tf > 0.0 && tf <= 80.0) { t = tf; hit = true; }
        }
    }
    var gl = vec3f(0.0);
    var gla = 0.0;
    if (glowing) {
        gl = u.u_control_solidrender3_glowAmount * u.u_control_solidrender3_glowColor.rgb * (1.0 - exp(-acc / reach));
        gla = min(max(gl.r, max(gl.g, gl.b)), 1.0);
    }
    let heat = count / 128.0;
    if (!hit) {
        var res = bg;
        res = vec4f(res.rgb + gl, res.a + gla * (1.0 - res.a));
        return res;
    }
    let pos = ro + rd * t;
    let e = vec2f(1.0, -1.0) * 0.0005 * max(1.0, t * 0.25);
    pp = pos + e.xyy;
    let n0 = min((pp.y - fh), scattersphere1_solid_d(pp).x);
    pp = pos + e.yyx;
    let n1 = min((pp.y - fh), scattersphere1_solid_d(pp).x);
    pp = pos + e.yxy;
    let n2 = min((pp.y - fh), scattersphere1_solid_d(pp).x);
    pp = pos + e.xxx;
    let n3 = min((pp.y - fh), scattersphere1_solid_d(pp).x);
    let n = normalize(e.xyy * n0 + e.yyx * n1 + e.yxy * n2 + e.xxx * n3);
    pp = pos;
    let floor_hit = ((pp.y - fh)) < scattersphere1_solid_d(pp).x;
    var albedo = mix(vec3f(0.34, 0.32, 0.38), vec3f(0.20, 0.19, 0.23), floor_mod(floor(pos.x) + floor(pos.z), 2.0));
    if (!floor_hit) { albedo = scattersphere1_solid(pos).yzw; }
    let fog = 1.0 - exp(-u.u_control_solidrender3_fog * t);
    let la = u.u_control_solidrender3_light * tau;
    let lh = u.u_control_solidrender3_lightHeight * tau;
    let light = normalize(vec3f(cos(lh) * sin(la), sin(lh), cos(lh) * cos(la)));
    var sh = 1.0;
    var st = 0.03;
    for (var j = 0; j < 32; j++) {
        pp = pos + n * 0.01 + light * st;
        let h = min((pp.y - fh), scattersphere1_solid_d(pp).x);
        sh = min(sh, 10.0 * h / st);
        st += clamp(h, 0.02, 0.6);
        if (sh < 0.01 || st > 20.0) { break; }
    }
    sh = clamp(sh, 0.0, 1.0);
    var occ = 0.0;
    for (var j = 1; j <= 5; j++) {
        let hk = 0.07 * f32(j);
        pp = pos + n * hk;
        occ += (hk - min((pp.y - fh), scattersphere1_solid_d(pp).x)) / f32(j);
    }
    let ao = clamp(1.0 - 2.5 * occ, 0.0, 1.0);
    let lin = pow(albedo, vec3f(2.2));
    let dif = max(dot(n, light), 0.0) * sh;
    let amb = (0.5 + 0.5 * n.y) * ao;
    let spe = pow(max(dot(n, normalize(light - rd)), 0.0), 40.0) * dif * 0.35;
    let col = pow(lin * (dif * 1.25 + amb * 0.30) + spe, vec3f(1.0 / 2.2));
    var res = vec4f(mix(col, unpremultiply(bg).rgb, fog), 1.0);
    res = vec4f(res.rgb + gl, res.a + gla * (1.0 - res.a));
    return res;
}

@compute @workgroup_size(64)
fn cs_place(@builtin(global_invocation_id) id: vec3u) {
    let t = id.x;
    switch id.z {
        case 0u: { scattersphere1_place(t); }
        default: {}
    }
}

@compute @workgroup_size(1)
fn cs_grid(@builtin(workgroup_id) wg: vec3u) {
    switch wg.z {
        case 0u: { sd_grid_finish(0u, 4096u, 4096.0); }
        default: {}
    }
}

@compute @workgroup_size(64)
fn cs_count(@builtin(global_invocation_id) id: vec3u) {
    let t = id.x;
    switch id.z {
        case 0u: { if (t < u32(sd_grid[0u].hi.w) && t < 500u) { sd_grid_count(0u, 0u, 0u, t); } }
        default: {}
    }
}

@compute @workgroup_size(256)
fn cs_scan(@builtin(workgroup_id) wg: vec3u, @builtin(local_invocation_index) lid: u32) {
    switch wg.z {
        case 0u: { sd_grid_scan(0u, 0u, 0u, 13500u, lid); }
        default: {}
    }
}

@compute @workgroup_size(64)
fn cs_fill(@builtin(global_invocation_id) id: vec3u) {
    let t = id.x;
    switch id.z {
        case 0u: { if (t < u32(sd_grid[0u].hi.w) && t < 500u) { sd_grid_fill(0u, 0u, 0u, 4096u, 13500u, 0u, t); } }
        default: {}
    }
}

@fragment
fn fs_main(@builtin(position) frag_coord: vec4f) -> @location(0) vec4f {
    let screenUV = frag_coord.xy / u.u_resolution;
    let aspectRatio = u.u_resolution.x / u.u_resolution.y;
    let uv = vec2f((2.0 * screenUV.x - 1.0) * aspectRatio, 2.0 * screenUV.y - 1.0);
    return solidrender3_output(uv);
}
