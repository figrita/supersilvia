---
source: tests/compile.rs
expression: wgsl
---

struct Uniforms {
    u_resolution: vec2f,
    u_time: f32,
    u_control_tunnel3d1_centerX: f32,
    u_control_tunnel3d1_centerY: f32,
    u_control_tunnel3d1_phaseOffset: f32,
    u_control_tunnel3d1_radius: f32,
    u_control_tunnel3d1_twist: f32,
    u_control_tunnel3d1_zoom: f32,
    u_count_tunnel3d1_clock: vec2f,
}
@group(0) @binding(0) var<uniform> u: Uniforms;

fn tunnelPathSine(z: f32, tw: f32) -> vec2f {
    return vec2f(sin(z * 0.29452431 + 1.7) * tw, cos(z * 0.49087385 + 2.3) * tw * 0.7);
}

fn tunnelPathHelix(z: f32, tw: f32) -> vec2f {
    return vec2f(cos(z * 0.39269908) * tw, sin(z * 0.39269908) * tw);
}

fn tunnelPathLissajous(z: f32, tw: f32) -> vec2f {
    return vec2f(sin(z * 0.29452431) * tw, sin(z * 0.49087385 + 1.5708) * tw);
}

fn tunnel3d1_output(uv: vec2f) -> vec4f {
    let p = uv - vec2f(u.u_control_tunnel3d1_centerX, u.u_control_tunnel3d1_centerY);
    let twist = u.u_control_tunnel3d1_twist;
    let tubeRadius = max(u.u_control_tunnel3d1_radius, 1e-3);
    let flight = time_repeat(u.u_count_tunnel3d1_clock, 64.0, u.u_control_tunnel3d1_phaseOffset);
    let camZ = flight - 64.0 * floor(flight / 64.0);
    let origin = vec3f(tunnelPathSine(camZ, twist), camZ);
    let lookZ = camZ + 0.5;
    let lookAt = vec3f(tunnelPathSine(lookZ, twist), lookZ);
    let forward = normalize(lookAt - origin);
    let right = normalize(cross(vec3f(0.0, 1.0, 0.0), forward));
    let up = cross(forward, right);
    let ray = normalize(p.x * right + p.y * up + (u.u_control_tunnel3d1_zoom) * forward);

    var marched = 0.0;
    for (var i = 0; i < 32; i++) {
        let probe = origin + ray * marched;
        let toWall = tubeRadius - length(probe.xy - tunnelPathSine(probe.z, twist));
        if (toWall < 0.001 || marched > 30.0) { break; }
        marched += toWall * 0.7;
    }

    let hit = origin + ray * marched;
    let axis = tunnelPathSine(hit.z, twist);
    let wallAngle = atan2(hit.x - axis.x, hit.y - axis.y);
    var depth = hit.z * 0.5;
    depth = abs(floor_mod(depth + 1.0, 4.0) - 2.0) - 1.0;
    let tunnelUV = vec2f(wallAngle / PI, depth);
    var wall = defaultUvMap(tunnelUV);
    return wall;
}

@fragment
fn fs_main(@builtin(position) frag_coord: vec4f) -> @location(0) vec4f {
    let screenUV = frag_coord.xy / u.u_resolution;
    let aspectRatio = u.u_resolution.x / u.u_resolution.y;
    let uv = vec2f((2.0 * screenUV.x - 1.0) * aspectRatio, 2.0 * screenUV.y - 1.0);
    return tunnel3d1_output(uv);
}
