  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Throw the puck in the XY Pad: its X twists the Kaleidoscope and its Y zooms it, and it bounces on by itself until Drag slows it. Hold the Button for a flash of white \u2014 the ADSR shapes it, so its Decay is how fast the flash fades. Alt+click the Button's Press, then hit a pad on a MIDI controller, to play it from there."
        }
      },
      "width": 380.0
    },
