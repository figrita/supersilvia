    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "One Master Gear half a second long is the beat, and Ratio Gears divide it into a bar (1 : 4) and a four-bar phrase (1 : 16). Both decks run on them, so whatever is on air stays on the beat. Turn the Master Gear's Length to retime the whole set at once \u2014 it bends, never jumps \u2014 and use its Hold and Reset to stop it and start again on the downbeat."
        }
      },
      "width": 380.0
    },
