{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Knobs ready for MIDI",
  "kind": "video",
  "blurb": "Alt+click a knob, turn a controller's: the ranges are set for it",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Alt+click any knob, then turn a knob on a MIDI controller: they are bound, and the knob wears a dot. A controller sweeps the knob's own range, so the ones worth playing here have been narrowed \u2014 Twist 0 to 3, Segments 3 to 12, Hue Shift 0 to 1 \u2014 and wear accent borders. Bindings are kept in the project rather than in a workspace: Project \u25b8 MIDI\u2026 lists them and clears them."
        }
      },
      "width": 380.0
    },
