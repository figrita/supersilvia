  "name": "Auto Gain keeps the level useful",
  "kind": "video",
  "blurb": "The loudness, stretched to fill 0 to 1 whatever the source",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "First choose a sound in the Main Input panel on the left, under Audio: a microphone, a Sound file, or System audio (what you hear). A quiet microphone's Level barely leaves zero and a loud song never comes down. Auto Gain follows the floor and the ceiling of what arrives and says where the level sits between them, 0 to 1, so the dots swell just as far for a whisper as for a stadium. Cable Level straight into the Reframe Range to see the difference."
        }
      },
      "width": 380.0
    },
