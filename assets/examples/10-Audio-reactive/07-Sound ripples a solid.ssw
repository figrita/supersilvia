    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "First choose a sound in the Main Input panel on the left, under Audio: a microphone, a Sound file, or System audio (what you hear). Bass, scaled from 0.04 to 0.3, is the Amount of a Displace on a ball: in silence it breathes gently, and a kick throws its surface out. The gear turns the ripples round. Try Mid into the Displace's Frequency as well."
        }
      },
      "width": 380.0
    },
