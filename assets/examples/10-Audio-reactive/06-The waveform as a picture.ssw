{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "The waveform as a picture",
  "kind": "video",
  "blurb": "The oscilloscope bent into a ring that leaves rainbow echoes",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "First choose a sound in the Main Input panel on the left, under Audio: a microphone, a Sound file, or System audio (what you hear). The Main Input's Oscilloscope is the sound's own wave as a line, flat in silence; Polar Coordinates bends it into a ring that an Oscillator breathes. The Output's last frame, zoomed in and shifted in hue, comes back under it as echoes. Try the Zoom below 1 to send the echoes inward."
        }
      },
      "width": 380.0
    },
    {
