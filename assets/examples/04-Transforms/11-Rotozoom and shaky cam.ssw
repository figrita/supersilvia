  "version": 1,
  "name": "Rotozoom and shaky cam",
  "kind": "video",
  "blurb": "A houndstooth turned and zoomed on interlocking waves, then shaken by hand",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Rotozoom turns and scales the picture on one pair of waves, so turning and zooming breathe together, and Shaky Cam slides it on four waves that never line up, like a hand-held camera. Both run on the Master Gear, so the loop closes. Turn Rotozoom's Sin and Cos Coefficients, or Shaky Cam's Amplitude."
        }
      },
      "width": 380.0
    },
