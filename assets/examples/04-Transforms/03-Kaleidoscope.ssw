      "options": {},
      "values": {
        "text": {
          "Text": "Kaleidoscope folds the picture into wedges around the middle, every other one mirrored, like a tube of mirrors. The noise behind it turns once a loop and the Oscillator swings Twist, which curls the wedges into a spiral. Turn Segments, or try Style Spiral."
        }
      },
      "width": 380.0
