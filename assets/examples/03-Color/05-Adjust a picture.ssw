      "options": {},
      "values": {
        "text": {
          "Text": "The adjusters each change one thing about a picture. Levels sets where black and white are, Contrast and Gamma bend the brightness, Saturate and Vibrance the colorfulness. An Oscillator swings Saturate from gray to vivid. Turn each one's knobs and watch the Output."
        }
      },
      "width": 380.0
    },
