      "values": {
        "text": {
          "Text": "Color Shift turns a picture's hue round the color wheel: a Hue Shift of 1 is the whole way round and back where it began. The Master Gear's Wrapped turns it once a loop, so this ember-colored kaleidoscope passes through every color. Turn its Saturation and Value too."
        }
      },
      "width": 380.0
    },
