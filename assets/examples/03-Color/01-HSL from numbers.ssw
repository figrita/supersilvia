    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "HSLA builds a color from four numbers: Hue, Saturation, Lightness and Alpha, each 0 to 1. Here World Coordinates give every pixel its own: X, reframed to 0 to 1, is the Hue, and Y is the Lightness, so the screen is a map of every color. The Master Gear turns the hue round. Drag Saturation on the HSLA."
        }
      },
      "width": 380.0
    },
