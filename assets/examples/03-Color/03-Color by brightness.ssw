      "values": {
        "text": {
          "Text": "Color Mapping grades a picture by its brightness: the dark parts take the Shadows color, the bright parts the Highlights, and the middle the Midtones. Its input here is a plain gray noise. Pick the three swatches; or put a Colorize in its place, which tints the whole picture with one color."
        }
      },
      "width": 380.0
    },
