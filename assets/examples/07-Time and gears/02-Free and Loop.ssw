    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Two Oscillators bob two dots, and the Output's own last frame, slid left, draws their paths. The top one is Free, and an Oscillator swings its Speed, so it rushes and lags; the bottom one is Loop, its Time a gear's count, exactly four waves a loop. Both do four waves a loop, so they meet again at the end. Click Free or Loop on either Timing heading to swap them."
        }
      },
      "width": 380.0
    },
