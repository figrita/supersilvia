    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "The gold hand is the Time node, the show's playhead in seconds, a turn every four seconds through its Multiply. The white one is the Clock, the time of day, sweeping once a minute. Pause the show with the button by the time readout, or F8: the gold hand stops and the white one carries on. Back to zero puts only the gold one at the top."
        }
      },
      "width": 380.0
    },
