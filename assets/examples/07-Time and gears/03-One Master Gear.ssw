    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "One Master Gear, four seconds long, drives three things: its Cycles walk the noise a cell and slide the palette once a loop, and its Phase turns the kaleidoscope once. Set the gear's Length to 2 and all three go twice as fast, together. Press Hold and everything stops on the same frame; Sync puts it back on the show's time."
        }
      },
      "width": 380.0
    },
