      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Six copies of one Oscillator on one Master Gear, each with its Offset a sixth of a wave further on, bob six dots. Together they make a wave that travels across. Set every Offset to 0 and they bob as one; spread them by a twelfth instead and the wave is twice as long."
        }
      },
      "width": 380.0
    },
