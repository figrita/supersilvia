    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Noise never repeats unless its Repeat says so. Here the Fractal and the Domain Warp both repeat every cell and the Master Gear moves them a cell a loop, so its caption says the loop closes in one cycle, 4 s: render the Output for that long and it plays round with no seam. Set the Fractal's Repeat to Never and the caption says it will not close."
        }
      },
      "width": 380.0
    },
