    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "The Output's Frame is cabled back into its own patch: each frame is the last one, zoomed in a little, turned and dimmed, with the triangle drawn over it \u2014 so the triangle leaves trails. Feedback always reads the frame before, which is what makes the loop allowed. Turn Color Shift's Value toward 1 for longer trails, or the Zoom below 1 to pull them inward."
        }
      },
      "width": 380.0
    },
