{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Draw with symmetry",
  "kind": "video",
  "blurb": "A drawing canvas that mirrors every stroke six ways, over its guide lines",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Paint on the Drawing Canvas node with the mouse. Symmetry is on 6-Fold, so every stroke comes back six times round the middle; the faint spokes behind are where the copies meet, drawn by Stripes bent round by Polar Coordinates. B, E, L, R, C and F pick pen, eraser, line, rectangle, circle and fill, and [ ] the size. Try Symmetry on HV Mirror for a plain four-way mirror, and press Clear to start again."
        }
      },
      "width": 380.0
    },
    {
      "id": 2,
      "slug": "drawingcanvas",
      "pos": {
        "x": 520.0,
        "y": 40.0
      },
      "controls": {
