      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A Note connects to nothing and changes nothing: it is words on the canvas, saved with the patch, for whoever opens it next \u2014 you included. Add one from the library like any node, type into it, and drag its edge to widen it. Arranging puts notes first, so here the one for each node follows this one, in the order the picture flows."
        }
      },
      "width": 380.0
    },
