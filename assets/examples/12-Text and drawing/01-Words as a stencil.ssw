    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Type into the Text node's box; a new line is a new line on screen, and Font, Size and Align are its menus. Besides its colored picture, Text has Ink: white letters on black, the shape of the words alone. Here Ink, read as a number, mixes a dim copy of a drifting palette into a bright one, so the letters are windows. Try another word, or Ink into a Blur first for soft edges."
        }
      },
      "width": 380.0
    },
