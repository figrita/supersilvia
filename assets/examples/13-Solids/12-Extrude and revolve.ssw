    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Pictures into solids: Extrude pushes out a blurred Text wherever it is brighter than Threshold, Depth deep, and Revolve spins the right half of a Polygon round the upright axis like a lathe into a spinning top. The Blur softens the letters' edge so the march can trust it; unplug it and the edges tear. Try Extrude's Depth and Bevel, the Polygon's Sides, and the Text's words."
        }
      },
      "width": 420.0
    },
