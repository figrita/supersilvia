  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A picture cabled into Render 3D's Sky is wrapped round the whole scene, above and below: its width goes once round the horizon and its height from pole to pole, so a Grid becomes lines of latitude and longitude. Bloom makes the lines glow, and a Translate driven by the Master Gear's Wrapped turns the sphere, since moving the picture along X turns the sky. The shiny ball and ring show it in their reflections. Try Sky Tilt in Render 3D's Look section to tip the pole, or the Grid's Cells."
        }
      },
      "width": 420.0
    },
