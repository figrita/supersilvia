    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Three Repeat Arounds of one shape each: twelve boxes in a ring standing on Z, seven balls in an arch where Spread is half a turn, and a spiral staircase round Y where each step Rises a little above the last, its post chained on after the Repeat so there is one post, not sixteen. Each Place moves its group into the row and a Union meets the three. Try the ring's Copies, the arch's Spread, and the staircase's Rise and Grow \u2014 grow it too far and the top steps are sliced by their neighbors' cells."
        }
      },
      "width": 380.0
    },
