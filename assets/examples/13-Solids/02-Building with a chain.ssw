{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Building with a chain",
  "kind": "solids",
  "blurb": "Shapes in a row, each landing on the ones before by Union, Subtract or Intersect",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Read the row left to right: every shape takes what was built so far into its Onto and lands on it by its Mode. A Sphere set to Intersect trims the Box into a rounded die, a Cylinder set to Subtract bores a hole through it, a Torus is melted round the middle by its Blend, and the Ground comes last so the Intersect never cuts it. Try the Torus's Blend up to 0.6, or the Cylinder's Mode set to Union."
        }
      },
      "width": 420.0
    },
