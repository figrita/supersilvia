    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A color field paints a solid by where its surface is and leaves its shape alone. Left to right: Checker 3D cuts a ball into cubes of two colors, Facing paints a dodecahedron by which way each face looks, Height Gradient runs a helix from blue to gold, and Stripes 3D bands a torus, the gear sliding the bands up through it. Try Checker 3D's Size, Facing's three colors, and Stripes 3D's Axis."
        }
      },
      "width": 380.0
    },
