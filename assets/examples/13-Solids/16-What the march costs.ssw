    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "The same twisted bar through two Render 3Ds: Lit on the left, and on the right Shading on Steps, which paints how hard the march worked for each pixel, blue for few steps to red for many. An Oscillator winds the Twist's Rate up and back; a twist has to shrink its distance to stay safe, so the harder it winds the hotter it reads, and at 64 Steps rays give up and pink gaps open along the lit bar's edges. Try both renders' Steps at 256 under Quality, or a Displace in place of the Twist."
        }
      },
      "width": 380.0
    },
