{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Video onto a solid",
  "kind": "solids",
  "blurb": "A video patch worn by a box, a cylinder and a ball through three Textures",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A Texture puts any picture on a solid's skin \u2014 here a turning kaleidoscope of checkers built in the same patch. Each Texture's Mapping makes a picture out of the surface its own way: Box wraps it from six sides, Around rolls it round the cylinder, Sphere maps it onto the ball. Try each Texture's Mapping and Scale, or move a Place before its Texture and the shape slides through the picture like a projector."
        }
      },
      "width": 380.0
    },
