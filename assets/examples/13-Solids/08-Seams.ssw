    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Three ways to meet two solids other than a plain union. Stairs Union joins a floor and a wall with a flight of steps; Columns Union fills the seam of a floor and a post with fluted columns; Exclusive keeps only where exactly one of two balls is, and a Box set to Subtract cuts the front open so the hollow overlap shows. Try Stairs Union's Steps and Radius, and Columns Union's Columns."
        }
      },
      "width": 380.0
    },
