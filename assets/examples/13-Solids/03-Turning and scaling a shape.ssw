      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Every shape turns and scales about its own center under its Transform heading. The Box turns by its own Yaw, cabled from the Master Gear; the Torus stands up by its Pitch and leans by its Roll; an Oscillator breathes the Octahedron's Scale. Drag any of the Yaw, Pitch, Roll or Scale rows \u2014 angles are in turns, so 0.25 is a quarter turn."
        }
      },
      "width": 380.0
    },
