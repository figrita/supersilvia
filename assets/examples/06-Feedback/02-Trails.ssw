  "name": "Trails",
  "kind": "video",
  "blurb": "A dot on a looping path leaving rainbow trails that turn and fade",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A small dot runs a figure of eight, and every frame it is drawn over the last frame, turned a little, shifted in hue and dimmed, so it leaves a fading rainbow trail. The Color Shift's Value is how long the trail lasts: 0.99 is very long, 0.9 short. Turn its Hue Shift, or the Rotate's Angle the other way."
        }
      },
      "width": 380.0
    },
