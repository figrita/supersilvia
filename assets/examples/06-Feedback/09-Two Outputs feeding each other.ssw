      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Here are two Outputs, and each one reads the other's Frame Out: the left draws a warm circle over the right's last frame turned, the right a cool square over the left's last frame shrunk. Every frame goes back and forth between them, so each picture holds the other's echoes. Watch both Outputs, and turn either Rotate or Zoom."
        }
      },
      "width": 380.0
    },
