{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Infinite tunnel",
  "kind": "video",
  "blurb": "A ring drawn over its own last frame, shrunk a little each time",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "The Output's Frame Out is the frame it drew last, and here it comes back in: shrunk by the Zoom, turned a hair by the Rotate, and drawn under a new square ring each frame. Every old ring shrinks a little further, so they fall away into a tunnel, colored by the palette as it was when each was drawn. Turn the Zoom toward 1 for a longer tunnel, or the Rotate's Angle for a twist."
        }
      },
      "width": 380.0
    },
