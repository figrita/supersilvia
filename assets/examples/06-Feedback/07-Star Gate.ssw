  "version": 1,
  "name": "Star Gate",
  "kind": "video",
  "blurb": "Slit-scan: a thin slit of live noise dragged out into a corridor",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Star Gate shows the live picture only in a thin slit and its Last Frame everywhere else, pushed away from the slit on both sides. Each frame the slit's colors are dragged a little further out, so the drifting noise streams into a corridor of light, the way the last reel of 2001 was shot. Turn Angle and Drift, or add some Perspective."
        }
      },
      "width": 380.0
    },
