    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "The last frame comes back nudged up by the Translate, swayed by the Wave, softened by the Blur and dimmed by the Color Shift, under a small spinning star. Old frames keep rising, swaying and spreading until they fade, so the star smokes. Turn the Wave's Amplitude for wilder smoke, or the Translate's Y Offset below zero to let it fall."
        }
      },
      "width": 380.0
    },
