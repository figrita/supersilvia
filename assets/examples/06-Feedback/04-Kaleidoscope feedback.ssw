  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "The last frame goes through a Kaleidoscope before it comes back, so every echo of the wandering dot is folded into six mirrored wedges, again and again, and the pattern blooms. The Kaleidoscope's Zoom just above 1 pushes each fold outward. Turn Segments, or Twist for a spinning flower."
        }
      },
      "width": 380.0
    },
