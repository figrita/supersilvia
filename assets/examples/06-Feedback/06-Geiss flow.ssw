  "name": "Geiss flow",
  "kind": "video",
  "blurb": "A spinning spiral dragged through a swirling flow, like ink in water",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Geiss Flow takes the last frame in its Last Frame, drags it along a swirling flow and fades it under the live picture, so the spiral pours out like ink in water. Distortion is how far a pixel travels each frame, Swirl how much the flow curls. Turn Feedback and Fade for longer-lived ink."
        }
      },
      "width": 380.0
    },
