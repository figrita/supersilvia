    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "The Output's Record section is open. Press Record, throw the XY Pad's puck around, and press Stop: the take is a video in recordings/ in the project, as long as you played, picture only. Render steps time a frame at a time, so it cannot follow your hands; Record keeps what really happened. Its FPS is its own, and its line counts any frame the show was too slow to draw."
        }
      },
      "width": 380.0
    },
