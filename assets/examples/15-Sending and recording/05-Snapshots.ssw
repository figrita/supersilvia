{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Snapshots",
  "kind": "video",
  "blurb": "Snap writes the frame in front of you as a full-size PNG",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Press Snap on the Output, or the Button cabled into it, and the frame in front of you is written as a PNG at the Output's full resolution into snaps/ in the project, while the show plays on. Snap is an action like Show on A, so a sequencer lane or a MIDI pad can take pictures too: Alt+click the Button's Press and hit a pad."
        }
      },
      "width": 380.0
    },
