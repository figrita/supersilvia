{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "A transparent Output",
  "kind": "video",
  "blurb": "A picture with its alpha kept, to lay over someone else's",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Only the stars are drawn: their Background is fully transparent, and the Output keeps the alpha. Its Render section writes a PNG sequence, which keeps it, as a Snap does; its Send section's Alpha, shown once Syphon or NDI is on, is set to Transparent, so a receiver can lay the stars over its own video. A video render or a recording drops the alpha: the picture over black."
        }
      },
      "width": 380.0
    },
