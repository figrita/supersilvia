      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Bloom gathers everything brighter than Threshold from around each pixel and adds it back, so the thin spiral glows like neon tubing. The Oscillator swings Intensity up and down. Turn Radius for a wider halo, or lower Threshold until the dark parts glow too."
        }
      },
      "width": 380.0
    },
