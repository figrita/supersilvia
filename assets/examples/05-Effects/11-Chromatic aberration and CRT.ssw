      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Chromatic Aberration pulls red, green and blue apart the way a cheap lens does, harder toward the edges. Camcorder CRT then bends the picture onto a curved tube with scanlines and phosphor glow. Turn Spread on the first, and Curvature, Scanlines and Glow on the second."
        }
      },
      "width": 380.0
    },
