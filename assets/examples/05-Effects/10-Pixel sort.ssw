  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Pixel Sort cuts every column into chunks and sorts the pixels in each by brightness, so the fractal runs down the screen like wet paint. Chunks whose contrast is under Threshold are left alone. Turn Threshold, or set Sort By to Hue and Direction to Horizontal."
        }
      },
      "width": 380.0
    },
