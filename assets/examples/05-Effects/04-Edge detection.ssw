      "options": {},
      "values": {
        "text": {
          "Text": "Edge Detection keeps only where the picture changes and drops the flat parts, so the posterized noise becomes a map of glowing contour lines. Turn Sample Distance for thicker lines and Strength for brighter ones, or set Mode to Laplacian. Pull the Posterize out to see what soft edges give."
        }
      },
      "width": 380.0
    },
