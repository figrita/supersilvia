{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Halftone",
  "kind": "video",
  "blurb": "A drifting rainbow noise printed in cyan, magenta, yellow and black dots",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Halftone prints the picture as dots, each one as big as the ink under it is strong. In CMYK mode every ink gets its own screen at its own angle, the way a press prints a magazine, so step back from the screen and the colors come back. Turn Dot Size, or set Mode to Mono for newsprint."
        }
      },
      "width": 380.0
    },
