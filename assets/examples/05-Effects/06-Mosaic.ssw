      "options": {},
      "values": {
        "text": {
          "Text": "Mosaic fills each cell with the color at its center and draws leading between them, so the drifting noise turns into stained glass. Voronoi cells scatter at random; try Shape Hexagon or Square. Turn Cell Freq for smaller pieces and Border Width for thicker leading."
        }
      },
      "width": 380.0
    },
