{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Dither",
  "kind": "video",
  "blurb": "A soft gradient broken into two-tone dots, like an old handheld screen",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Dither turns a smooth number into just two colors by checking it against a fixed pattern of thresholds, so gray becomes a pattern of dots. Here the number is the brightness of a drifting noise, and the two colors are an old handheld's greens. Turn Scale for bigger pixels, or try Mode Noise."
        }
      },
      "width": 380.0
    },
