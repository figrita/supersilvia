{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Game of Life",
  "kind": "video",
  "blurb": "Conway's Life on a wrapping grid, with fading trails",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Conway's Game of Life: a cell is born with three live neighbors and lives on with two or three. Auto-Run steps it thirty times a second, and Trail Decay leaves a fading ghost where cells died. When it settles into blinkers, press Randomize; Init Threshold, read on that press, is how empty the new grid starts. The world wraps round at its edges, so its picture tiles; the Zoom brings one tile up to the frame's height."
        }
      },
      "width": 380.0
    },
    {
      "id": 2,
      "slug": "cellularautomata",
      "pos": {
        "x": 520.0,
        "y": 40.0
      },
      "controls": {
        "autoRun": {
          "Float": 1.0
        },
        "stepsPerFrame": {
          "Float": 1.0
        },
        "initThreshold": {
          "Float": 0.7
        },
        "trailDecay": {
