{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "A sequencer plays the brick game",
  "kind": "video",
  "blurb": "Two sequencer lanes hold the paddle left and right",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Brick Game is played with events. Lane 1 of the Step Sequencer holds Paddle Left for half a bar and Lane 2 holds Paddle Right for the other half, so the paddle sweeps back and forth, catching the ball now and then, and Auto Reset starts a new game when it misses. Each broken brick fires Brick Broken, which picks a new color; click cells to play better, or turn on Auto Play."
        }
      },
      "width": 380.0
    },
