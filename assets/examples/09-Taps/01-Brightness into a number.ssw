  "name": "Brightness into a number",
  "kind": "video",
  "blurb": "A Tap's Mean brightness, through Auto Gain, sizes a light",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A Tap passes its picture through and measures it: its Mean is the average brightness, a frame later. Auto Gain follows that number's floor and ceiling and stretches it to 0 to 1, and a Reframe Range makes it the light's radius: the brighter the noise, the bigger the light. Swap the noise for a Main Input to measure your camera."
        }
      },
      "width": 380.0
    },
