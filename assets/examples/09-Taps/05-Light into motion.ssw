{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Light into motion",
  "kind": "video",
  "blurb": "A Tap's centroid follows the bright part of a moving noise",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A Tap's X and Y say where its quantity is, weighted by how much of it there is: the center of the light. Here the Tap measures the bright blobs a Smoothstep cuts out of the noise, through its Number input, and the diamond is put where they are, so it drifts after the light. Move the Smoothstep's edges to choose how bright counts."
        }
      },
      "width": 380.0
    },
