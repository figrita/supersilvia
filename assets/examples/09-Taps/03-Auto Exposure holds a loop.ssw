{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "Auto Exposure holds a loop",
  "kind": "video",
  "blurb": "A feedback tunnel kept at one brightness by Auto Exposure",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "The Output's own last frame, zoomed and shifted in hue, is added under a turning star, every frame. Added light only grows, so on its own the loop runs to white; Auto Exposure measures it and scales it so its mean sits at its Target. Turn the Target, or cable the Color Shift straight into the Layer Blend to watch it burn out."
        }
      },
      "width": 380.0
    },
