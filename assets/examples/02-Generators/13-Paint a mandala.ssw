      "values": {
        "text": {
          "Text": "The Drawing Canvas is a picture you paint. Drag on its canvas: with Symmetry on R8 every stroke is repeated eight times round the middle, a mandala. It is screened over a slowly cycling palette, so the dark canvas shows the colors through. Pick a Tool and a Color, or press Clear."
        }
      },
      "width": 380.0
    },
