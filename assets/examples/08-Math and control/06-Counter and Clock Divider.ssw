    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A quarter-second Master Gear fires its Trigger every beat. One Counter counts the beats round 0 to 3 and steps the dot across. A Clock Divider passes one beat in four to a second Counter, which counts the polygon's sides round 3 to 6. Set the Divide to 2, or the second Counter's Ends to Clamp to stop at the top."
        }
      },
      "width": 380.0
    },
