      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Mux (Event) holds one of four inputs and moves on an event: Next, Prev, Random or Reset. Here a one-second gear's Trigger presses Next, so the picture steps through four effects of one pattern, a beat each. Press the Button to jump to one at random, or Reset on the mux to go back to the first."
        }
      },
