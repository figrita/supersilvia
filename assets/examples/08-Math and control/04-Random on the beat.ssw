    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Random gives the same number for the same Seed, so a seed that steps gives a new number each step. Here a half-second gear's Cycles, floored and wrapped round 8 by Modulo, is the seed: three Randoms place and size the dot, and Random Hurl, a random color a pixel, rerolls the static inside it. Every eighth beat the pattern comes back; set the Modulo to 16 for a longer one."
        }
      },
      "width": 380.0
    },
