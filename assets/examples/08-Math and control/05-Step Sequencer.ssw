    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A Master Gear two seconds long is a bar, and the Step Sequencer walks its sixteen steps across it. Each lane fires an ADSR when it reaches a lit cell, and each envelope pops one light. Click cells in the grid to change the rhythm; set the Master Gear's Length to 1 for double time."
        }
      },
      "width": 380.0
    },
