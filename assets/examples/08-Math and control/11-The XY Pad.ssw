    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "The XY Pad is a puck in a box, with physics. Its X and Y move the kaleidoscope's center, and its Temp keeps it wandering on its own. Drag the puck to throw it; right-drag to drop a gravity well it falls toward, and right-click the well to take it away. Set Temp to 0 and it slides to rest."
        }
      },
      "width": 380.0
    },
