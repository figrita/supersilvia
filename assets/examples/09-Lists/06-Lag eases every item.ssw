    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Lag eases each item of a list toward where it is going: Rise is how slowly an item climbs and Fall how slowly it sinks, in seconds. A Random list of sixteen heights is rerolled once a second, and through the Lag the bars leap up at once and settle slowly, the way a meter's do. Take the Lag out and cable the Random straight into the Stamp to see them jump, or set Rise and Fall the same."
        }
      },
      "width": 380.0
    },
