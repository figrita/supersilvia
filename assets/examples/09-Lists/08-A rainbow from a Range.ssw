  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "HSLA fed a list gives a color list, one color an item. A Range of twelve from 0 to 1 is twelve hues round the wheel; the Add moves them on by the Master Gear and the Modulo brings each back under 1, so the colors run round once a loop. The color list goes into the Kaleidoscope's Color under Per copy, and the Range into Segments makes as many wedges as colors, over stripes turning half a turn a loop. Try the Range's Count, or the HSLA's Saturation and Lightness."
        }
      },
      "width": 380.0
    },
