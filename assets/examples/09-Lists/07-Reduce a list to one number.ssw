  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "Reduce makes one number from a whole list: its Sum, its Mean, its lowest, its highest, or Argmax, the place of the highest. The bars are a Random list eased by a Lag. One Reduce on Argmax says which bar is tallest, and the maths turns that place into the ball's X; another on Max says how tall, half of which is the top of the bar, for the ball's Y. Try the second Reduce on Mean, and the ball floats over the tallest bar at the bars' average height."
        }
      },
      "width": 380.0
    },
