  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A solid repeat takes lists on its Per copy rows the way a picture repeat does. Twenty-eight slabs go round a Repeat Around: a Range into Offset Y lifts each step above the last, and a Range into an HSLA's Hue paints them red round to violet. The post is chained on after the Repeat, so there is one post, not twenty-eight. The Oscillator swings the height Range's To, so the stair stretches and settles. Try a Range from 0 to 0.5 into Turn, which twists each step about its own center, or one into Scale X."
        }
      },
      "width": 380.0
    },
