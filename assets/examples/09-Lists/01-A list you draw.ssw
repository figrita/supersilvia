{
  "format": "supersilvia-workspace",
  "version": 1,
  "name": "A list you draw",
  "kind": "video",
  "blurb": "A List node's bars, one bar of a Stamp each",
  "layout": "linear",
  "nodes": [
    {
      "id": 1,
      "slug": "note",
      "pos": {
        "x": 40.0,
        "y": 40.0
      },
      "controls": {},
      "options": {},
      "values": {
        "text": {
          "Text": "A list is many numbers on one cable, the double diamond. The List node's are drawn by hand: drag up and down across its bars. Its List goes into the Stamp's Count, so there is a copy for each bar, and into Scale Y under Per copy, so copy i is as tall as bar i. The Oscillator swings the List's Max, and every bar follows. Redraw the bars, set Count to 24, or cable the List into Turn as well."
        }
      },
      "width": 380.0
    },
